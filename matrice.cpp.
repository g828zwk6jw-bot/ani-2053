#include <iostream>

#include <fstream>

#include <vector>

#include <string>

#include <algorithm>

using namespace std;

struct Entry {

    string name, label, kind, target, cell;

    int value, cost;

};

int main() {

    ifstream file("matrice.txt");

    if (!file) return 1;

    int n;

    file >> n;

    vector<Entry> entries(n);

    for (auto &e : entries) {

        file >> e.name >> e.value >> e.cost

             >> e.label >> e.kind;

        if (e.kind == "SOCLE")

            file >> e.target;

    }

    for (auto &e : entries) {

        if (e.kind == "REECRITURE" ||

            e.kind == "CHOIX" || e.label == "-")

            continue;

        if (e.kind == "SOCLE") {

            for (const auto &t : entries) {

                if (t.name == e.target) {

                    e.value = max(e.value, t.value);

                    break;

                }

            }

        }

        bool v = e.value >= 3;

        bool c = e.cost >= 3;

        if (v && !c) e.cell = "MAINTENANT";

        else if (v && c) e.cell = "DECOUPER";

        else if (!v && !c) e.cell = "EN_PASSANT";

        else e.cell = "ON_NE_LE_FAIT_PAS";

    }

    for (const auto &e : entries) {

        if (e.kind == "REECRITURE")

            cout << "HORS_LISTE " << e.name << " reecriture\n";

        else if (e.kind == "CHOIX")

            cout << "HORS_LISTE " << e.name << " choix\n";

        else if (e.label == "-")

            cout << "HORS_LISTE " << e.name << " sans_label\n";

    }

    vector<Entry> sorted;

    for (const auto &e : entries)

        if (!e.cell.empty()) sorted.push_back(e);

    vector<string> order = {

        "MAINTENANT", "DECOUPER",

        "EN_PASSANT", "ON_NE_LE_FAIT_PAS"

    };

    sort(sorted.begin(), sorted.end(),

         [&](const Entry &a, const Entry &b) {

        int x = find(order.begin(), order.end(), a.cell) - order.begin();

        int y = find(order.begin(), order.end(), b.cell) - order.begin();

        if (x != y) return x < y;

        return a.name < b.name;

    });

    bool refused = false;

    for (const auto &e : sorted) {

        cout << "CELL " << e.cell << " "

             << e.name << " " << e.label << "\n";

        if (e.cell == "ON_NE_LE_FAIT_PAS")

            refused = true;

    }

    if (refused)

        cout << "VERDICT HONNETE\n";

    return 0;

}